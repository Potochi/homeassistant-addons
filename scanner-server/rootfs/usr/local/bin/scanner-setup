#!/usr/bin/with-contenv bashio
# ==============================================================================
# Runs once before the daemons:
#   - reports what is actually attached to the USB bus, so a scanner that is
#     unplugged or asleep is obvious from the log instead of showing up later
#     as an empty scanner list
#   - regenerates AirSane's options.conf from the add-on options
#
# Options are read straight from /data/options.json rather than through
# bashio::config, which goes via the Supervisor API and caches its answer.
# ==============================================================================
set -e

readonly OPTIONS=/data/options.json

opt() {
    jq -r "${1} // empty" "${OPTIONS}"
}

mkdir -p /run/dbus

# ------------------------------------------------------------------------------
# Publish under the host's name, not the container's.
#
# Avahi and AirSane both derive names from gethostname(), which inside an
# add-on container is the slug ("<hash>-scanner-server"). That name ends up as
# the SRV target of the scanner service and in the adminurl/representation TXT
# records, and nothing on the network can resolve any of it. Clients still see
# the scanner in their browse list - the instance name is just a label - and
# then hang when they try to open it. AirSane's URLs are handled separately
# with --announce-base-url=http://%H:8090, which picks up whatever Avahi is
# configured with here.
# ------------------------------------------------------------------------------
host_name="$(bashio::info.hostname || true)"

if [[ -z "${host_name}" || "${host_name}" == "null" ]]; then
    bashio::log.warning \
        "Could not ask the Supervisor for the host name; falling back to 'homeassistant'. If the scanner is found but will not open, this is why."
    host_name=homeassistant
fi

sed -i "s/^host-name=.*/host-name=${host_name}/" /etc/avahi/avahi-daemon.conf
bashio::log.info "Publishing the scanner as ${host_name}.local"

# ------------------------------------------------------------------------------
# USB inventory. 0x04b8 is Seiko Epson; 0x013f is the Perfection V39 II, which
# is the one model whose firmware this image is guaranteed to carry.
# ------------------------------------------------------------------------------
found=0
for device in /sys/bus/usb/devices/*; do
    [[ -r "${device}/idVendor" && -r "${device}/idProduct" ]] || continue

    vendor="$(<"${device}/idVendor")"
    product="$(<"${device}/idProduct")"
    [[ "${vendor}" == "04b8" ]] || continue

    found=1
    name="$(cat "${device}/product" 2>/dev/null)"
    bashio::log.info "Found Epson ${name:-device} on USB (04b8:${product})"

    if [[ "${product}" == "013f" ]]; then
        bashio::log.info \
            "Perfection V39 II detected; it is driven by the esci backend and firmware esfw0282.bin is pushed to it on the first scan"
    fi
done

if [[ "${found}" -eq 0 ]]; then
    bashio::log.warning \
        "No Epson device (vendor 04b8) is attached. Check the cable and that the add-on has USB access, then restart."
fi

# ------------------------------------------------------------------------------
# AirSane device options. Regenerated on every start so the add-on options stay
# the single source of truth; anything hand-edited here is lost on restart.
#
# Values are written verbatim, which is also what makes extra_options a usable
# escape hatch for the SANE backend options this add-on does not model.
# ------------------------------------------------------------------------------
{
    echo "# Generated by the Scanner Server add-on. Edits are overwritten on restart."
    echo "icon Gnome-scanner.png"

    location="$(opt '.location')"
    if [[ -n "${location}" ]]; then
        echo "location ${location}"
    fi

    # macOS interprets scan data with a gamma of 1.8 baked in and offers no way
    # to reassign the profile, so images come back dark. Pre-applying the
    # inverse cancels it out.
    if [[ "$(opt '.macos_gamma_fix')" == "true" ]]; then
        echo "gray-gamma 0.555555"
        echo "color-gamma 0.555555"
    fi

    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        echo "${line}"
    done < <(jq -r '.extra_options[]? // empty' "${OPTIONS}")
} > /etc/airsane/options.conf

bashio::log.info "Scanner server is ready"
